#!/usr/bin/env python
from modules.VFIO import VFIO
import argcomplete
import argparse
import json
import os
import sys

_scriptRoot = os.path.dirname(os.path.dirname(__file__))
argsFile    = "%s/args.json" % _scriptRoot

def main():
    with open(argsFile) as f:
        argsToBuild = json.loads(f.read())

    # Set our description
    parser = argparse.ArgumentParser(description=argsToBuild['_description'])

    # Build arguments from file
    for argumentToBuild in argsToBuild['arguments']:
        if '_ignore' in argumentToBuild:
            if argumentToBuild['_ignore']:
                continue

        for key in ['default', 'type']:
            if key in argumentToBuild:
                if argumentToBuild[key] in [str.__name__, int.__name__]:
                    argumentToBuild[key] = eval(argumentToBuild[key])

        parser.add_argument(*argumentToBuild['option_strings'], **argumentToBuild)

    argcomplete.autocomplete(parser)
    args      = parser.parse_args()
    args_dict = {k: v for k,v in args.__dict__.items()}

    vfio    = VFIO(args=args_dict)
    outcome = vfio.run()
    print(outcome)
    sys.exit(outcome)


if __name__ == '__main__':
    main()
